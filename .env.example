# Education Platform Environment File
# Copy this to .env and adjust values as needed

# =======================================
# APPLICATION
# =======================================
APP_NAME=education-platform
APP_ENV=development
APP_DEBUG=true

# =======================================
# SERVER
# =======================================
SERVER_PORT=8081
FRONTEND_PORT=3000
PHPMYADMIN_PORT=8080

# =======================================
# DATABASE - MySQL
# =======================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=education_db
DB_USER=education_user
DB_PASSWORD=education_password
DB_ROOT_PASSWORD=root_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# =======================================
# SPRING BOOT CONFIGURATION
# =======================================
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/education_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=education_user
SPRING_DATASOURCE_PASSWORD=education_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_PROFILES_ACTIVE=mysql

# =======================================
# LOGGING
# =======================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EDUCATION=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG

# =======================================
# FILE UPLOAD
# =======================================
APP_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20MB

# =======================================
# FRONTEND CONFIGURATION
# =======================================
VITE_API_URL=http://localhost:8081
VITE_API_BASE_URL=/api

# =======================================
# DOCKER REGISTRY
# =======================================
REGISTRY=docker.io
REGISTRY_NAMESPACE=your-namespace
REGISTRY_USERNAME=your-username
REGISTRY_PASSWORD=your-password

# =======================================
# JENKINS CONFIGURATION
# =======================================
JENKINS_URL=http://localhost:8080
SONARQUBE_URL=http://localhost:9000

# =======================================
# SECURITY
# =======================================
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=86400000

# =======================================
# CORS CONFIGURATION
# =======================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =======================================
# OPTIONAL SERVICES
# =======================================
ENABLE_PHPMYADMIN=true
ENABLE_SONARQUBE=false
ENABLE_JENKINS=false
